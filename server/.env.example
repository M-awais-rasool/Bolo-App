# Copy to .env for local development. Never commit .env.
ENV=development
PORT=8080
DATABASE_URL=postgres://bolo:bolo@localhost:5432/bolo?sslmode=disable
# Required outside development; generate with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# S3-compatible object storage (dev defaults match docker-compose MinIO).
# Packs are public; audio is private — never the same bucket.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=bolo
S3_SECRET_KEY=bolo-secret
S3_USE_SSL=false
S3_PACKS_BUCKET=bolo-packs
S3_AUDIO_BUCKET=bolo-audio

# Attempt audio is deleted after this window (retention sweep job).
AUDIO_RETENTION=2160h

# Pronunciation scorer: "stub" until a vendor adapter lands.
SPEECH_SCORER=stub

# Lesson generation (cmd/contentgen): "stub" (templates) or "anthropic".
CONTENTGEN_PROVIDER=stub
CONTENTGEN_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
